# Placeholder __BACKEND_HOST__ is replaced by deployment/scripts/deploy.sh into app-active.conf.
# Variable proxy_pass + Docker's resolver avoids stale upstream IPs after container recreate.

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name _;

    client_max_body_size 100M;

    location / {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $django_upstream "__BACKEND_HOST__:7000";
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        proxy_pass http://$django_upstream;
    }
}
