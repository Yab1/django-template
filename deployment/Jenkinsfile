/*
 * Enterprise CD Pipeline - vendor-management-core
 *
 * Job config (Jenkins UI / JCasC):
 *   - Pipeline script from SCM
 *   - Script Path: deployment/Jenkinsfile
 *   - Pin agent: change `agent any` -> agent { label 'deploy' } on Docker host
 *
 * Preferred secrets (Credentials Plugin, secret-file):
 *   - Pass ENV_CREDENTIAL_ID / SECRETS_CREDENTIAL_ID params, OR
 *   - Set folder/job env JENKINS_ENV_CREDENTIAL_ID / JENKINS_SECRETS_CREDENTIAL_ID
 * Legacy fallback: host paths in deployment/scripts/config.sh
 *
 * Official refs:
 *   https://www.jenkins.io/doc/book/pipeline/jenkinsfile/
 *   https://www.jenkins.io/doc/book/pipeline/pipeline-best-practices/
 */
def resolveCredentialId(String paramValue, String envKey) {
    def fromParam = (paramValue ?: '').trim()
    if (fromParam) {
        return fromParam
    }
    return (env[envKey] ?: '').trim()
}

def materializeEnvFiles(String envCredId, String secretsCredId, String requireSecrets) {
    def binds = []
    if (envCredId) {
        binds << file(credentialsId: envCredId, variable: 'ENV_FILE')
    }
    if (secretsCredId) {
        binds << file(credentialsId: secretsCredId, variable: 'SECRETS_FILE')
    }

    def prepare = {
        sh """
            set -euo pipefail
            export REQUIRE_SECRETS='${requireSecrets}'
            chmod +x deployment/scripts/*.sh
            ./deployment/scripts/prepare-env.sh
        """
    }

    if (binds) {
        withCredentials(binds) {
            prepare()
        }
    } else {
        prepare()
    }
}

pipeline {
    // Production tip: replace with agent { label 'deploy' } on a dedicated Docker host.
    agent any

    options {
        disableConcurrentBuilds(abortPrevious: true)
        buildDiscarder(logRotator(
            numToKeepStr: '30',
            artifactNumToKeepStr: '10',
            daysToKeepStr: '60'
        ))
        timeout(time: 90, unit: 'MINUTES')
        timestamps()
        parallelsAlwaysFailFast()
        durabilityHint('MAX_SURVIVABILITY')
        skipDefaultCheckout(false)
    }

    parameters {
        choice(
            name: 'DEPLOY_ACTION',
            choices: ['deploy', 'status', 'preflight-only'],
            description: 'deploy = blue-green release; status = compose ps; preflight-only = checks only'
        )
        string(
            name: 'ENV_CREDENTIAL_ID',
            defaultValue: '',
            description: 'Optional Credentials secret-file ID for .env (else legacy host path in config.sh)'
        )
        string(
            name: 'SECRETS_CREDENTIAL_ID',
            defaultValue: '',
            description: 'Optional Credentials secret-file ID for .secrets.yml'
        )
        booleanParam(
            name: 'REQUIRE_SECRETS',
            defaultValue: true,
            description: 'Fail Prepare if secrets file missing'
        )
        booleanParam(
            name: 'SKIP_PREFLIGHT',
            defaultValue: false,
            description: 'Skip tooling / disk / compose checks'
        )
        booleanParam(
            name: 'SKIP_SMOKE',
            defaultValue: false,
            description: 'Skip post-deploy HTTP smoke on :6000/health/'
        )
        booleanParam(
            name: 'CLEAN_WORKSPACE',
            defaultValue: false,
            description: 'Wipe workspace after build (Workspace Cleanup plugin)'
        )
    }

    environment {
        PROJECT_NAME           = 'vendor_management'
        COMPOSE_DOCKER_CLI_BUILD = '1'
        DOCKER_BUILDKIT        = '1'
        // Masked-ish build metadata for notifications
        GIT_SHA_SHORT          = "${env.GIT_COMMIT ? env.GIT_COMMIT.take(7) : 'unknown'}"
    }

    stages {
        stage('Preflight') {
            when {
                expression { return !params.SKIP_PREFLIGHT }
            }
            steps {
                sh '''
                    set -euo pipefail
                    chmod +x deployment/scripts/*.sh
                    ./deployment/scripts/preflight.sh
                '''
            }
        }

        stage('Prepare Environment') {
            when {
                expression { return params.DEPLOY_ACTION == 'deploy' }
            }
            steps {
                script {
                    def envCredId = resolveCredentialId(
                        params.ENV_CREDENTIAL_ID as String,
                        'JENKINS_ENV_CREDENTIAL_ID'
                    )
                    def secretsCredId = resolveCredentialId(
                        params.SECRETS_CREDENTIAL_ID as String,
                        'JENKINS_SECRETS_CREDENTIAL_ID'
                    )
                    def requireSecrets = params.REQUIRE_SECRETS ? '1' : '0'
                    materializeEnvFiles(envCredId, secretsCredId, requireSecrets)
                }
            }
        }

        stage('Status') {
            when {
                expression { return params.DEPLOY_ACTION == 'status' }
            }
            steps {
                sh '''
                    set -euo pipefail
                    chmod +x deployment/scripts/*.sh
                    ./deployment/scripts/orchestrate.sh status
                '''
            }
        }

        stage('Deploy') {
            when {
                expression { return params.DEPLOY_ACTION == 'deploy' }
            }
            steps {
                milestone(ordinal: 100, label: 'deploy-gate')
                retry(2) {
                    sh '''
                        set -euo pipefail
                        chmod +x deployment/scripts/*.sh
                        ./deployment/scripts/deploy.sh
                    '''
                }
            }
        }

        stage('Smoke') {
            when {
                allOf {
                    expression { return params.DEPLOY_ACTION == 'deploy' }
                    expression { return !params.SKIP_SMOKE }
                }
            }
            steps {
                sh '''
                    set -euo pipefail
                    chmod +x deployment/scripts/*.sh
                    ./deployment/scripts/smoke.sh
                '''
            }
        }
    }

    post {
        always {
            script {
                def message = """
                    *Pipeline finished*
                    Job: ${env.JOB_NAME}
                    Build: #${env.BUILD_NUMBER}
                    Result: ${currentBuild.currentResult}
                    Branch: ${env.GIT_BRANCH ?: 'N/A'}
                    Commit: ${env.GIT_SHA_SHORT}
                    Action: ${params.DEPLOY_ACTION}
                    Duration: ${currentBuild.durationString.replace(' and counting', '')}
                    Console: ${env.BUILD_URL}console
                """.stripIndent().trim()
                echo message
            }
            sh '''
                set +e
                chmod +x deployment/scripts/cleanup-secrets.sh 2>/dev/null
                ./deployment/scripts/cleanup-secrets.sh || rm -f .env .secrets.yml
            '''
        }

        success {
            script {
                echo """
                    ✅ *Deployment Successful*
                    Job: ${env.JOB_NAME} #${env.BUILD_NUMBER}
                    Branch: ${env.GIT_BRANCH ?: 'N/A'}
                    Commit: ${env.GIT_SHA_SHORT}
                    Duration: ${currentBuild.durationString.replace(' and counting', '')}
                """.stripIndent()

                // Uncomment when Slack Notification plugin + credential configured:
                // slackSend(color: 'good', channel: '#deployments', message: "✅ ${env.JOB_NAME} #${env.BUILD_NUMBER} OK (${env.GIT_SHA_SHORT})")
            }
        }

        failure {
            script {
                echo """
                    ❌ *Deployment Failed*
                    Job: ${env.JOB_NAME} #${env.BUILD_NUMBER}
                    Branch: ${env.GIT_BRANCH ?: 'N/A'}
                    Commit: ${env.GIT_SHA_SHORT}
                    Console: ${env.BUILD_URL}console
                """.stripIndent()

                // slackSend(color: 'danger', channel: '#deployments', message: "❌ ${env.JOB_NAME} #${env.BUILD_NUMBER} FAILED — ${env.BUILD_URL}console")
            }
        }

        aborted {
            echo "Pipeline aborted (concurrent build superseded or manual abort)."
        }

        cleanup {
            script {
                if (params.CLEAN_WORKSPACE) {
                    try {
                        cleanWs(
                            deleteDirs: true,
                            disableDeferredWipeout: true,
                            notFailBuild: true
                        )
                    } catch (ignored) {
                        echo "[WARN] cleanWs unavailable (install Workspace Cleanup plugin) or failed: ${ignored}"
                    }
                }
            }
        }
    }
}
