# ========================================================================
# Basic Django Configuration
# ========================================================================
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE="config.django.base"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS="*"

# APP_DOMAIN + OpenAPI "Servers": full URL, or hostname + port.
# Port 443 => https://host (no :443 in URL). Any other port => http://host:port.
# localhost / 127.0.0.1 with empty port => port 6000, http.
# HTTPS on non-443: set DJANGO_APP_DOMAIN=https://api.example.com
DJANGO_APP_DOMAIN=localhost
DJANGO_APP_PORT=6000

# Human-readable reference ID prefix (e.g. HB for HealthBridge)
DJANGO_REFERENCE_ID_PLATFORM_PREFIX=HB

# Optional: assigning-authority URL for auto-generated patient MRNs (default: {APP_DOMAIN}/fhir/sid/patient-mrn)
# DJANGO_PATIENT_MRN_IDENTIFIER_SYSTEM=https://ehr.example.com/fhir/sid/patient-mrn
# DJANGO_PATIENT_MRN_NUMERIC_WIDTH=9
# First MRN number when the sequence row is first created (default 0). Change only before first issue or edit DB.
# DJANGO_PATIENT_MRN_SEQUENCE_START=0

# ========================================================================
# CSRF and Session Configuration
# ========================================================================
# Required when using HTTPS or a separate frontend origin (admin, cookies).
# DJANGO_CSRF_TRUSTED_ORIGINS="https://api.example.com,http://localhost:3000"
DJANGO_CSRF_COOKIE_DOMAIN=
DJANGO_SESSION_COOKIE_DOMAIN=

# ========================================================================
# CORS Configuration
# ========================================================================
DJANGO_CORS_ORIGIN_WHITELIST="http://localhost:3000"
# Note: DJANGO_CORS_ALLOW_CREDENTIALS is not read by this project; see config/settings/cors.py.

# ========================================================================
# Debug Toolbar Configuration
# ========================================================================
DJANGO_DEBUG_TOOLBAR_ENABLED=True

# ========================================================================
# Silk Profiler Configuration
# ========================================================================
DJANGO_SILK_ENABLED=False

# ========================================================================
# Database Configuration
# ========================================================================
DJANGO_DB_NAME="vendor_management"
DJANGO_DB_USER="vendor_admin"
DJANGO_DB_PASSWORD="change_me"
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432

# ========================================================================
# File and Storage Configuration (Django)
# ========================================================================
DJANGO_DEFAULT_FILE_STORAGE="storages.backends.s3boto3.S3Boto3Storage"
DJANGO_FILE_STORAGE_ENDPOINT="localhost:9000"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME="vendor_management"
AWS_S3_CUSTOM_DOMAIN=""
AWS_S3_REGION_NAME="us-east-1"
AWS_S3_USE_SSL=False
AWS_S3_VERIFY=False

# Bucket names must be DNS-compliant (lowercase letters, digits, hyphens only; no underscores).
MINIO_ROOT_USER="vendor_admin"
MINIO_ROOT_PASSWORD="change_me"
MINIO_STORAGE_ENDPOINT="localhost:9077"
MINIO_STORAGE_MEDIA_BUCKET_NAME="ehr-minio-backend"
MINIO_STORAGE_STATIC_BUCKET_NAME="ehr-minio-static"
MINIO_STORAGE_USE_HTTPS=False
# Public URL browsers use for admin CSS/JS. Must match where you run collectstatic.
# Local (recommended — set explicitly so a stale shell env cannot point at prod):
MINIO_STORAGE_STATIC_URL="http://localhost:9077/ehr-minio-static"
# Prod example:
# MINIO_STORAGE_STATIC_URL="https://media.healthbridgeehr.com/ehr-minio-static"

# ========================================================================
# Celery Configuration
# ========================================================================
CELERY_BROKER_URL="amqp://guest:guest@localhost:5672/vendor_management"

# ========================================================================
# Cache (Redis) — django-redis; DB index 1 by default to avoid clashing with other tools on DB 0
# Authenticated: redis://:PASSWORD@host:6379/1
# ========================================================================
DJANGO_CACHE_REDIS_URL=redis://127.0.0.1:6379/1
DJANGO_CACHE_REDIS_MAX_CONNECTIONS=50
DJANGO_CACHE_REDIS_SOCKET_CONNECT_TIMEOUT=5
DJANGO_CACHE_REDIS_SOCKET_TIMEOUT=5
DJANGO_CACHE_REDIS_HEALTH_CHECK_INTERVAL=30

# Channels (WebSocket fan-out). Must be Redis when Daphne + Celery are separate
# processes (make dev). Use a different DB index than cache (e.g. /2 vs /1).
# Local Docker: often host port 7377 — same password as DJANGO_CACHE_REDIS_URL.
DJANGO_CHANNEL_REDIS_URL=redis://127.0.0.1:6379/2

# ========================================================================
# Sentry Configuration
# ========================================================================
SENTRY_DSN=""

# ========================================================================
# Unfold Environment Variables
# ========================================================================
DJANGO_ENVIRONMENT=development

# ========================================================================
# JWT Authentication (djangorestframework-simplejwt)
# ========================================================================
# Dedicated signing key for JWT (recommended; omit to fall back to DJANGO_SECRET_KEY)
# DJANGO_JWT_SIGNING_KEY=
# Access token lifetime in minutes (default 60). Local/dev example for 1 day: 1440
# DJANGO_JWT_ACCESS_TOKEN_LIFETIME_MINUTES=1440
# Refresh token lifetime in days (default 1)
# DJANGO_JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ========================================================================
# Notification Module
# ========================================================================

# Twilio (SMS delivery)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_WEBHOOK_AUTH_TOKEN=""

# FCM — Android push (Legacy HTTP API; migrate to FCM v1 when google-auth added)
FCM_SERVER_KEY=""
FCM_PROJECT_ID=""
FCM_SERVICE_ACCOUNT_FILE=""

# APNs — iOS push (requires: uv add h2)
APNS_KEY_FILE=""
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_BUNDLE_ID=""
APNS_USE_SANDBOX=True

# Email transport
# DJANGO_EMAIL_BACKEND options:
#   console → django.core.mail.backends.console.EmailBackend  (local dev — prints to terminal)
#   smtp    → django.core.mail.backends.smtp.EmailBackend     (production SMTP / relay)
#   ses     → django_ses.SESBackend                           (AWS SES, requires django-ses)
DJANGO_EMAIL_BACKEND="django.core.mail.backends.smtp.EmailBackend"
DJANGO_EMAIL_HOST="localhost"
DJANGO_EMAIL_PORT=1025
DJANGO_EMAIL_USE_TLS=False
DJANGO_EMAIL_USE_SSL=False
DJANGO_EMAIL_HOST_USER=""
DJANGO_EMAIL_HOST_PASSWORD=""
DJANGO_EMAIL_TIMEOUT=10
NOTIFICATION_EMAIL_FROM="noreply@healthbridgeehr.com"

# Deep-link tokens for SMS/email bodies (signed JWT, PHI-free, 15-min default)
NOTIFICATION_DEEP_LINK_BASE_URL="http://localhost:3000"
NOTIFICATION_DEEP_LINK_TOKEN_TTL_SECONDS=900

# Telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_PARSE_MODE="HTML"

# WhatsApp (provider: twilio or meta)
WHATSAPP_PROVIDER="twilio"
WHATSAPP_FROM_NUMBER=""
# Meta WhatsApp Cloud API (only when WHATSAPP_PROVIDER=meta)
META_WHATSAPP_PHONE_NUMBER_ID=""
META_WHATSAPP_ACCESS_TOKEN=""

# Fax (provider: twilio)
FAX_PROVIDER="twilio"
FAX_FROM_NUMBER=""

# Pager (provider: twilio_sms — SMS-to-pager gateway)
PAGER_PROVIDER="twilio_sms"
PAGER_FROM_NUMBER=""

# ========================================================================
# Internal Environment Variables (Django)
# ========================================================================
DJANGO_DEV_DOCKER=1
DJANGO_SECRETS_FILE_PATH=".secrets.yml"