# Copy to .env. No export.
# Local: localhost + published infra ports. Server: Jenkins JENKINS_ENV_FILE →
# deploy/.env. Compose env_file. No export.
# Own database, Redis DB indexes, buckets, and host port.
# App containers join Docker network `django_template` so hostnames postgres/redis/rabbitmq/minio/mailpit/clamav resolve.
# Create database django_template and grant DJANGO_DB_USER before first migrate.
# Quote values that contain # $ ! & so bash `source` (deploy scripts) and Compose keep them.

# --- app ---
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE="config.django.base"
DJANGO_SECRET_KEY="dev-django-secret-key-change-me"
DJANGO_ALLOWED_HOSTS="*"

# Local listen port for `make run` + OpenAPI/APP_DOMAIN when domain has no scheme.
# Change THIS to move local server (e.g. 8002). Ignore PORT / APP_PORT below for local.
# Override once: make run DJANGO_APP_PORT=8100
DJANGO_APP_DOMAIN=localhost
DJANGO_APP_PORT=8000

# --- deploy ports (docker / blue-green only; NOT used by `make run`) ---
# Inside API container — Gunicorn bind + healthcheck. Keep 8000 unless image changes.
PORT=8000
# Host → nginx proxy publish (`deploy/docker-compose.yml`). Public machine port in prod.
APP_PORT=8000

# Frontend origin (password-reset links, CORS companion). No trailing slash.
DJANGO_FRONTEND_URL=http://localhost:3000

# Shown in app settings / health flags (development | staging | production)
DJANGO_ENVIRONMENT=development

# Human-readable reference ID prefix (DT for Django Template). Used by ReferenceIdMixin.
DJANGO_REFERENCE_ID_PLATFORM_PREFIX=DT

# Process name (JWT default iss/aud when those vars are empty, DB application_name)
DJANGO_APP_NAME=django-template

# Default DRF permission. false = AllowAny globally (views can still override).
DJANGO_AUTH_REQUIRED=true

# Catalog permission checks. false = skip role/permission gates (JWT still required).
# Keep false until core.security is fully ported.
DJANGO_PERMISSIONS_ENABLED=false

# Skip load_superusers when false (deploy seed stage still invokes the command).
DJANGO_SEED_ENABLED=true

# CIDRs/IPs allowed to set X-Forwarded-For / X-Forwarded-Proto. Empty = trust REMOTE_ADDR only.
DJANGO_TRUSTED_PROXIES=

# --- log ---
# Logging. DJANGO_LOG_FORMAT: console | json
DJANGO_LOG_LEVEL=DEBUG
DJANGO_LOG_FORMAT=console

# --- rate limit ---
# DRF throttles. Off by default. AUTH = anon/min, READ = user/min, WRITE = throttle_scope=write.
DJANGO_RATE_LIMIT_ENABLED=false
DJANGO_RATE_LIMIT_AUTH=10
DJANGO_RATE_LIMIT_WRITE=120
DJANGO_RATE_LIMIT_READ=600

# --- swagger ---
# OpenAPI / Swagger UI at /docs /schema /redoc (admin session). false unregisters those routes.
DJANGO_SWAGGER_ENABLED=true
DJANGO_SWAGGER_TITLE="Django Template API"
DJANGO_SWAGGER_DESCRIPTION="REST API for Django Template."
# DJANGO_SWAGGER_VERSION=0.1.0
# DJANGO_SWAGGER_TOS=
DJANGO_SWAGGER_CONTACT_NAME="Django Template"
DJANGO_SWAGGER_CONTACT_EMAIL=
DJANGO_SWAGGER_CONTACT_URL=
DJANGO_SWAGGER_EXTERNAL_DOCS_URL=
DJANGO_SWAGGER_EXTERNAL_DOCS_DESC=

# --- gunicorn ---
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=300
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_LOG_LEVEL=info
GUNICORN_PROC_NAME=django_template_gunicorn

# --- csrf / session ---
# Required when using HTTPS or a separate frontend origin (admin, cookies).
# DJANGO_CSRF_TRUSTED_ORIGINS="https://api.example.com,http://localhost:3000"
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_CSRF_COOKIE_DOMAIN=
DJANGO_SESSION_COOKIE_DOMAIN=

# --- cors ---
DJANGO_CORS_ENABLED=true
# * is DJANGO_CORS_ALLOW_ALL=true (forces credentials off — browsers forbid * + cookies).
DJANGO_CORS_ALLOW_ALL=false
DJANGO_CORS_ALLOW_CREDENTIALS=true
DJANGO_CORS_ORIGIN_WHITELIST="http://localhost:3000"

# --- debug toolbar ---
DJANGO_DEBUG_TOOLBAR_ENABLED=True

# --- silk ---
DJANGO_SILK_ENABLED=False

# --- database ---
# Prefer django_template_postgres from `make infra-up` (infra/.env).
# Host port comes from infra/.env POSTGRES_PORT (default 5432). Remap there if host :5432 is taken.
DJANGO_DB_NAME="django_template"
DJANGO_DB_USER="admin"
DJANGO_DB_PASSWORD="password"
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432
# libpq. disable | allow | prefer | require | verify-ca | verify-full
DJANGO_DB_SSLMODE=disable
# Seconds to wait for TCP + auth. Not a pool size.
DJANGO_DB_CONNECT_TIMEOUT=10
# Persistent connections per worker (seconds). 0 = close after request.
# Keep 0 unless pgbouncer / sized max_connections.
DJANGO_DB_CONN_MAX_AGE=0
DJANGO_DB_CONN_HEALTH_CHECKS=False

# --- files / blob ---
# Static files: always WhiteNoise (CompressedManifestStaticFilesStorage). NOT MinIO.
# Media/uploads: DJANGO_STORAGE_DRIVER = local | s3 | minio.
# Empty DJANGO_DEFAULT_FILE_STORAGE uses the driver mapping.
DJANGO_FILES_ENABLED=true
DJANGO_STORAGE_DRIVER=minio
DJANGO_FILE_MAX_BYTES=10485760
# Comma-separated MIME allowlist for POST /api/v1/files/upload/
DJANGO_FILE_ALLOWED_TYPES=image/jpeg,image/png,image/webp,application/pdf
# Optional class override. Leave empty so DJANGO_STORAGE_DRIVER wins.
DJANGO_DEFAULT_FILE_STORAGE=
DJANGO_FILE_STORAGE_ENDPOINT="localhost:9000"
# Virus scan on upload via clamd (make infra-up-scanning). When true, uploads fail while clamd is down.
CLAMAV_ENABLED=false
CLAMAV_HOST="localhost"
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME="django_template"
AWS_S3_CUSTOM_DOMAIN=""
AWS_S3_REGION_NAME="us-east-1"

# MinIO = media/uploads only. Keep in sync with infra/.env (MINIO_*).
# Bucket names must be DNS-compliant (lowercase letters, digits, hyphens only; no underscores).
MINIO_ROOT_USER="django_template_minio"
MINIO_ROOT_PASSWORD="minioadmin"
MINIO_STORAGE_ENDPOINT="localhost:9000"
MINIO_STORAGE_MEDIA_BUCKET_NAME="django-template-media"
MINIO_STORAGE_STATIC_BUCKET_NAME="django-template-static"
MINIO_STORAGE_USE_HTTPS=False
# Unused for collectstatic (WhiteNoise serves /static/). Kept for django-minio-storage compatibility.
MINIO_STORAGE_STATIC_URL=
MINIO_STORAGE_MEDIA_URL="http://localhost:9000/django-template-media"
# Media bucket policy is NONE (private).

# --- rabbitmq / celery ---
# Broker is RabbitMQ. RABBITMQ_* is the source of truth (keep in sync with infra/.env).
# Leave CELERY_BROKER_URL empty to assemble amqp://USER:PASSWORD@HOST:PORT/VHOST.
# Set CELERY_BROKER_URL only to override. Results stay in django-db.
# Local host: RABBITMQ_HOST=localhost. App containers: RABBITMQ_HOST=rabbitmq.
RABBITMQ_USER=django_template
RABBITMQ_PASSWORD=change_me
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=django_template
CELERY_BROKER_URL=

# --- redis ---
# django-redis; DB index 1 by default to avoid clashing with other tools on DB 0.
# Authenticated: redis://:PASSWORD@host:6379/1 — percent-encode # ! & $ in PASSWORD.
# false = DummyCache (ready/health report cache as not_configured).
DJANGO_CACHE_ENABLED=true
DJANGO_CACHE_REDIS_URL=redis://:dev-redis-change-me@127.0.0.1:6379/1
DJANGO_CACHE_REDIS_MAX_CONNECTIONS=50
DJANGO_CACHE_REDIS_SOCKET_CONNECT_TIMEOUT=5
DJANGO_CACHE_REDIS_SOCKET_TIMEOUT=5
DJANGO_CACHE_REDIS_HEALTH_CHECK_INTERVAL=30

# Channels (WebSocket fan-out). Must be Redis when Daphne + Celery are separate
# processes (make dev). Use a different DB index than cache (e.g. /2 vs /1).
# Same host/password as DJANGO_CACHE_REDIS_URL; different DB index.
DJANGO_CHANNEL_REDIS_URL=redis://:dev-redis-change-me@127.0.0.1:6379/2

# --- sentry ---
SENTRY_DSN=""
# SENTRY_ENVIRONMENT=local
# SENTRY_RELEASE=
# SENTRY_SEND_DEFAULT_PII=False
# SENTRY_DEBUG=False

# --- jwt ---
# Dedicated signing key for JWT (recommended; omit to fall back to DJANGO_SECRET_KEY)
# DJANGO_JWT_SIGNING_KEY=
# Access token lifetime in minutes (default 60). Local/dev example for 1 day: 1440
# DJANGO_JWT_ACCESS_TOKEN_LIFETIME_MINUTES=1440
# Refresh token lifetime in days (default 1)
# DJANGO_JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# Optional iss/aud claims. Empty = SimpleJWT does not set/verify them.
# DJANGO_JWT_ISSUER=django-template
# DJANGO_JWT_AUDIENCE=django-template

# --- notifications ---
DJANGO_MAIL_ENABLED=true
NOTIFICATION_DISPATCH_ENABLED=false
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_SMS_ENABLED=false
NOTIFICATION_PUSH_ENABLED=false
NOTIFICATION_IN_APP_ENABLED=true
NOTIFICATION_TELEGRAM_ENABLED=false
NOTIFICATION_POLL_INTERVAL_SECONDS=15
NOTIFICATION_BATCH_SIZE=25
NOTIFICATION_MAX_ATTEMPTS=5
# Webhook adapters (SMS / push): POST JSON {to, subject, body}
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
PUSH_PROVIDER_URL=
PUSH_PROVIDER_TOKEN=

# Twilio (SMS delivery)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_WEBHOOK_AUTH_TOKEN=""

# FCM — Android push (Legacy HTTP API; migrate to FCM v1 when google-auth added)
FCM_SERVER_KEY=""
FCM_PROJECT_ID=""
FCM_SERVICE_ACCOUNT_FILE=""

# APNs — iOS push (requires: uv add h2)
APNS_KEY_FILE=""
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_BUNDLE_ID=""
APNS_USE_SANDBOX=True

# Email transport
# DJANGO_EMAIL_BACKEND options:
#   console → django.core.mail.backends.console.EmailBackend  (local dev — prints to terminal)
#   smtp    → django.core.mail.backends.smtp.EmailBackend     (production SMTP / relay)
#   ses     → django_ses.SESBackend                           (AWS SES, requires django-ses)
DJANGO_EMAIL_BACKEND="django.core.mail.backends.smtp.EmailBackend"
DJANGO_EMAIL_HOST="localhost"
DJANGO_EMAIL_PORT=1025
DJANGO_EMAIL_USE_TLS=False
DJANGO_EMAIL_USE_SSL=False
DJANGO_EMAIL_HOST_USER=""
DJANGO_EMAIL_HOST_PASSWORD=""
DJANGO_EMAIL_TIMEOUT=10
DJANGO_EMAIL_FROM_NAME=django-template
NOTIFICATION_EMAIL_FROM="noreply@localhost"

# Deep-link tokens for SMS/email bodies (signed JWT, PHI-free, 15-min default)
NOTIFICATION_DEEP_LINK_BASE_URL="http://localhost:3000"
NOTIFICATION_DEEP_LINK_TOKEN_TTL_SECONDS=900

# Telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_PARSE_MODE="HTML"

# WhatsApp (provider: twilio or meta)
WHATSAPP_PROVIDER="twilio"
WHATSAPP_FROM_NUMBER=""
# Meta WhatsApp Cloud API (only when WHATSAPP_PROVIDER=meta)
META_WHATSAPP_PHONE_NUMBER_ID=""
META_WHATSAPP_ACCESS_TOKEN=""

# Fax (provider: twilio)
FAX_PROVIDER="twilio"
FAX_FROM_NUMBER=""

# Pager (provider: twilio_sms — SMS-to-pager gateway)
PAGER_PROVIDER="twilio_sms"
PAGER_FROM_NUMBER=""

# --- seed ---
DJANGO_SECRETS_FILE_PATH=".secrets.yml"
