# -------------------------------
# Basic Django Configuration
# -------------------------------
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE="config.django.base"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS="*"
APP_DOMAIN=localhost
APP_PORT=7000

# -------------------------------
# CSRF and Session Configuration
# -------------------------------
CSRF_COOKIE_DOMAIN=
SESSION_COOKIE_DOMAIN=

# -------------------------------
# CORS Configuration
# -------------------------------
CORS_ORIGIN_WHITELIST=
DJANGO_CORS_ORIGIN_WHITELIST="http://localhost:3000"

# -------------------------------
# Debug Toolbar Configuration
# -------------------------------
DEBUG_TOOLBAR_ENABLED=True
SHOW_TOOLBAR_CALLBACK=True

# -------------------------------
# Database Configuration
# -------------------------------
DB_NAME="ehr_django_template"
DB_USER="ehr_django_admin"
DB_PASSWORD="ehr_django_secure_2025"
DB_HOST=localhost
DB_PORT=5432

# -------------------------------
# File and Storage Configuration
# -------------------------------
DEFAULT_FILE_STORAGE="storages.backends.s3boto3.S3Boto3Storage"
FILE_STORAGE_ENDPOINT="localhost:9000"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME="django_template"
AWS_S3_CUSTOM_DOMAIN=""
AWS_S3_REGION_NAME="us-east-1"
AWS_S3_USE_SSL=False
AWS_S3_VERIFY=False

MINIO_ROOT_USER="minio_admin"
MINIO_ROOT_PASSWORD="minio_admin_2025"
MINIO_STORAGE_ENDPOINT="localhost:9000"
MINIO_STORAGE_MEDIA_BUCKET_NAME="django_minio_adam"
MINIO_STORAGE_STATIC_BUCKET_NAME="django_minio_static"
MINIO_STORAGE_USE_HTTPS=False

# -------------------------------
# Celery Configuration
# -------------------------------
CELERY_BROKER_URL="amqp://guest:guest@localhost:5672//"

# -------------------------------
# Sentry Configuration
# -------------------------------
SENTRY_DSN=""

# -------------------------------
# Unfold Environment Variables
# -------------------------------
DJANGO_ENVIRONMENT=development
APOLLO_ROUTER_URL="http://localhost:4000"
GRAPHQL_PLAYGROUND_URL="http://localhost:7004/graphql/"

# -------------------------------
# Keycload Configuration
# -------------------------------
KC_BASE_URL="http://localhost:8081"
KC_CLIENT_ID="ehr-django-template"
KC_CLIENT_SECRET=

# -------------------------------
# Django Tenant DB Router SETUP
# -------------------------------
TENANT_AUTO_CREATE_DATABASE=true
TENANT_DB_PREFIX="ehr_django_template_"
# -------------------------------
# gRPC SETUP
# -------------------------------
SERVICE_NAME="ehr_django_template"
SERVICE_TOKEN_SECRET="dev-shared-secret"
SERVICE_TOKEN_AUDIENCE="ehr-services"
SERVICE_TOKEN_ISSUER="ehr-id"
SERVICE_TOKEN_LEEWAY_SECONDS=120
SERVICE_ROLES=admin,reader,writer

# TLS configuration
GRPC_REQUIRE_CLIENT_AUTH=true
GRPC_TLS_ENABLED=false

#  TLS certificate files
GRPC_TLS_CERT_FILE="certs/server.crt"
GRPC_TLS_KEY_FILE="certs/server.key"
GRPC_TLS_CA_FILE="certs/ca.crt"
GRPC_CLIENT_CERT_FILE="certs/client_idir.crt"
GRPC_CLIENT_KEY_FILE="certs/client_idir.key"

# gRPC Client Endpoints
GRPC_ENDPOINT_EHR_TENANT="localhost:50051"
GRPC_ENDPOINT_EHR_PATIENT="localhost:50054"

# -------------------------------
# Git Credentials for Private Packages
# -------------------------------
GIT_USERNAME=""
GIT_TOKEN=""

# -------------------------------
# Internal Environment Variables
# -------------------------------
SECRETS_FILE_PATH=".secrets.yml"