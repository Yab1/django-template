{
  // ==============================
  // Editor settings
  // ==============================
  "editor.formatOnSave": true,
  "editor.insertSpaces": true,
  "editor.tabSize": 4,
  "editor.codeActionsOnSave": {
    "source.fixAll.ruff": "explicit",
    "source.organizeImports.ruff": "explicit"
  },

  // ==============================
  // Language-specific editor settings
  // ==============================
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },

  // ==============================
  // File exclude patterns
  // ==============================
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/venv": false
  },

  // ==============================
  // Python extension settings
  // ==============================
  "cursorpyright.analysis.typeCheckingMode": "basic",
  "python.analysis.typeCheckingMode": "basic",
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.envFile": "${workspaceFolder}/.env",
  "python.languageServer": "None",
  "python.terminal.activateEnvironment": true,

  // ==============================
  // Theme and UI Customizations
  // ==============================
  "peacock.color": "#9778c7",
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#b39cd6",
    "activityBar.background": "#b39cd6",
    "activityBar.foreground": "#15202b",
    "activityBar.inactiveForeground": "#15202b99",
    "activityBarBadge.background": "#f6eee8",
    "activityBarBadge.foreground": "#15202b",
    "commandCenter.border": "#15202b99",
    "sash.hoverBorder": "#b39cd6",
    "statusBar.background": "#9778c7",
    "statusBar.foreground": "#15202b",
    "statusBarItem.hoverBackground": "#7b54b8",
    "statusBarItem.remoteBackground": "#9778c7",
    "statusBarItem.remoteForeground": "#15202b",
    "titleBar.activeBackground": "#9778c7",
    "titleBar.activeForeground": "#15202b",
    "titleBar.inactiveBackground": "#9778c799",
    "titleBar.inactiveForeground": "#15202b99"
}
}
