# Copy to .env: cp .env.example .env
# Loaded by compose (ports/command/healthcheck) and by containers (env_file where used).
# If 5432/5672/6379/9000 are already taken on this host, remap the host ports here.

# --- postgres (PostGIS) ---
# App: DJANGO_DB_HOST=localhost DJANGO_DB_PORT=${POSTGRES_PORT} DJANGO_DB_NAME=${POSTGRES_DB}
# Image is postgis/postgis:${POSTGRES_IMAGE_TAG} (Postgres 18 + PostGIS 3.6).
POSTGRES_IMAGE_TAG=18-3.6
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=django_template
POSTGRES_PORT=5432

# --- redis ---
# App cache: DJANGO_CACHE_REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:${REDIS_PORT}/1
# App channels: DJANGO_CHANNEL_REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:${REDIS_PORT}/2
# Celery does not use Redis (broker = RabbitMQ, results = django-db).
REDIS_IMAGE_TAG=8.2.5-alpine
REDIS_PORT=6379
REDIS_PASSWORD=dev-redis-change-me
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# --- rabbitmq (Celery broker) ---
# Keep RABBITMQ_USER / PASSWORD / VHOST in sync with the app .env.
# App host: localhost (make celery). Docker network hostname: rabbitmq.
RABBITMQ_IMAGE_TAG=3.13.7-management
RABBITMQ_USER=django_template
RABBITMQ_PASSWORD=change_me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_VHOST=django_template

# --- mailpit ---
# App: DJANGO_EMAIL_BACKEND=console (dev) or smtp → DJANGO_EMAIL_HOST=localhost DJANGO_EMAIL_PORT=1025
MAILPIT_IMAGE_TAG=latest
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- minio ---
# App: MINIO_STORAGE_ENDPOINT=localhost:${MINIO_API_PORT}
# Console: http://localhost:${MINIO_CONSOLE_PORT}
# Create buckets once in the MinIO console (no auto-init container).
MINIO_IMAGE_TAG=RELEASE.2025-09-07T16-13-09Z
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=django_template_minio
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=django-template-media

# --- clamav (make up-scanning only) ---
# App: CLAMAV_HOST=localhost CLAMAV_PORT=${CLAMAV_PORT}. Docker network hostname: clamav.
CLAMAV_IMAGE_TAG=1.4
CLAMAV_PORT=3310
