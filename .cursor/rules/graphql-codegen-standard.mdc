- app: goals
  model: Goal
  enabled: true
  description: "Goal model"

  generate:
    types: true
    inputs: true
    input_partial: true
    mutations: true
    queries: true
    filters: true
    orders: true
    services: true

  relationship_mappings:
    # ... relationships ...

