    addresses = models.ManyToManyField(
        "fhir.CodeableReference",  # ← CodeableReference: needs use_reference_only: true
        ...
    )
    
    subject = models.ForeignKey(
        "fhir.Reference",  # ← NOT CodeableConcept/Coding/CodeableReference: no use_reference_only
        ...
    )
```

