  enabled: true
  description: "GoalStart model"

  generate:
    types: true
    inputs: true
    input_partial: true
    mutations: false
    queries: false
    filters: true
    orders: true
    services: true

  relationship_mappings:
    # ... relationships ...

- app: goals
  model: GoalTarget
  enabled: true
  description: "GoalTarget model"

  generate:
    types: true
    inputs: true
    input_partial: true
    mutations: false
    queries: false
    filters: true
    orders: true
    services: true

  relationship_mappings:
    # ... relationships ...
```

