# Build context is the repo root (`deploy/docker-compose.yml`).
# Runtime image: Django app + venv. Env is injected at run (`env_file`), not baked in.

# --- secrets (never copy) ---
.env
.env.*
.secrets.yml
*.pem
*.key
google_client_secret.json
env/

# --- git / hooks / editors ---
.git
.gitignore
.githooks
.pre-commit-config.yaml
.cursor
.claude
.idea
.vscode
.kiro
*.swp
*.swo
*~

# --- os ---
.DS_Store
.DS_Store?
._*
Thumbs.db

# --- python / venv / caches ---
__pycache__
*.py[cod]
*$py.class
*.so
.Python
.venv
venv
ENV
.mypy_cache
.pytest_cache
.hypothesis
.ruff_cache
.tox
.nox
*.egg-info
.eggs
build
dist
htmlcov
.coverage
.coverage.*
coverage.xml
*.cover

# --- tests (not loaded in production) ---
**/tests
pytest.ini

# --- local infra, docs, agent graph, collections ---
infra
docs
*.md
postman
graphify-out
makefiles
Makefile
notes
value_sets

# --- runtime junk ---
logs
*.log
tmp
temp
.tmp
media
staticfiles
celerybeat-schedule
celerybeat.pid
db.sqlite3
node_modules

# --- host-side deploy (compose/jenkins/nginx run on the host) ---
deploy/*
!deploy/entrypoint.sh
!deploy/worker-entrypoint.sh
!deploy/gunicorn.config.py
Dockerfile*
docker-compose*
.dockerignore

# --- host scripts; image build only needs install.sh ---
scripts
!scripts/install.sh
